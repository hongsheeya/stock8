# Generate a value with: openssl rand -hex 32
WIZ_SECRET_KEY=replace-with-a-random-64-character-value

# Use a real domain (for automatic HTTPS) or :80 (HTTP by IP address).
STOCK8_SITE_ADDRESS=:80

TZ=Asia/Seoul
WIZ_DB_MAX_CONCURRENCY=4

# Fail-closed trading environment. Keep PAPER for this deployment.
TRADING_MODE=PAPER
STOCK8_PAPER_DB_PATH=project/main/data/paper/trading.db
STOCK8_DAYTRADE_HARD_LOCK=false
