//- ============================================================
//- Access Page — Login / Signup (Glassmorphism Dark Theme)
//- ============================================================

div(class="min-h-screen flex items-center justify-center px-4 py-10 auth-bg")

    div(class="auth-shell w-full max-w-5xl")

        //- Brand Header
        div(class="auth-brand-panel")
            span(class="auth-eyebrow") AUTOMATED INVESTING · PAPER FIRST
            div(class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-cyan-400/10 border border-cyan-300/20 mb-5")
                svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 48 48", fill="none",
                    class="w-9 h-9")
                    //- Infinity symbol
                    path(d="M12 18c-3.5 0-6.5 3-6.5 6s3 6 6.5 6c2.8 0 5-1.6 7-4l5-6c2-2.4 4.2-4 7-4 3.5 0 6.5 3 6.5 6s-3 6-6.5 6c-2.8 0-5-1.6-7-4l-5 6", stroke="url(#inf-lg)", stroke-width="3", stroke-linecap="round", fill="none")
                    //- Dollar at center
                    path(d="M24 20v8M22 22c0-1.1 1-2 2-2s2 .7 2 1.6c0 1.4-2 1.4-2 2.4 0 .9 1 1.6 2 1.6s2-1 2-2", stroke="#a5b4fc", stroke-width="1.5", stroke-linecap="round", fill="none")
                    defs
                        linearGradient(id="inf-lg", x1="5.5", y1="24", x2="42.5", y2="24", gradientUnits="userSpaceOnUse")
                            stop(offset="0%", stop-color="#818cf8")
                            stop(offset="100%", stop-color="#c084fc")
            h1(class="text-3xl font-bold text-white")
                span(class="infinity-text") ∞
                | STOCK8
            h2(class="auth-brand-title") 반복은 시스템에게,<br>판단은 투자자에게.
            p(class="auth-brand-copy") 무한매수 전략의 계획, 실행, 기록을 한 화면에서 관리하세요. 모의투자로 충분히 검증한 뒤 다음 단계를 결정합니다.
            div(class="auth-feature-list")
                div
                    span 01
                    p KIS 모의투자 안전 검증
                div
                    span 02
                    p 무한매수 회차 자동 관리
                div
                    span 03
                    p 거래 기록과 리스크 추적

        //- Card Container
        div(class="glass-card auth-card p-8")

            //- ========== LOGIN VIEW ==========
            div(*ngIf="view === 'login'")
                h2(class="text-lg font-semibold text-white mb-1") 로그인
                p(class="text-[13px] text-slate-400 mb-6") 계정 정보를 입력하여 로그인하세요.

                //- Error Message
                div(*ngIf="errorMsg",
                    class="mb-4 px-3 py-2.5 rounded-lg bg-red-500/10 border border-red-400/20 text-red-300 text-[13px] flex items-center gap-2")
                    svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 20 20", fill="currentColor", class="size-4 shrink-0")
                        path(fill-rule="evenodd", d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z", clip-rule="evenodd")
                    span {{errorMsg}}

                div(class="space-y-4")
                    //- Email
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 이메일
                        input(type="email",
                            autocomplete="email",
                            [(ngModel)]="loginData.email",
                            placeholder="name@example.com",
                            class="auth-input")

                    //- Password
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 비밀번호
                        input(type="password",
                            autocomplete="current-password",
                            [(ngModel)]="loginData.password",
                            (keyup.enter)="login()",
                            placeholder="비밀번호 입력",
                            class="auth-input")

                    //- Login Button
                    button((click)="login()",
                        [disabled]="loading",
                        class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg bg-indigo-500 hover:bg-indigo-400 disabled:opacity-50 disabled:cursor-not-allowed text-white text-[13px] font-semibold transition-colors")
                        svg(*ngIf="loading", class="size-4 animate-spin", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24")
                            circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4")
                            path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z")
                        span {{loading ? '로그인 중...' : '로그인'}}

                //- Signup Link
                div(class="mt-6 text-center")
                    span(class="text-[13px] text-slate-500") 계정이 없으신가요?
                    | &nbsp;
                    button((click)="switchView('signup')",
                        class="text-[13px] text-indigo-400 hover:text-indigo-300 font-medium transition-colors") 회원가입
                div(class="mt-4 grid grid-cols-2 gap-2")
                    button((click)="switchView('find-id')",
                        class="rounded-lg border border-slate-700 px-3 py-2 text-[12px] text-slate-300 hover:border-indigo-400/60 hover:text-white transition-colors") 아이디 찾기
                    button((click)="switchView('reset-password')",
                        class="rounded-lg border border-slate-700 px-3 py-2 text-[12px] text-slate-300 hover:border-indigo-400/60 hover:text-white transition-colors") 비밀번호 재설정
                p(class="mt-3 text-center text-[11px] leading-5 text-slate-500") 이전 서버의 사용자 DB는 새 로컬 설치에 자동으로 연결되지 않습니다.

            //- ========== SIGNUP VIEW ==========
            div(*ngIf="view === 'signup'")
                h2(class="text-lg font-semibold text-white mb-1") 회원가입
                p(class="text-[13px] text-slate-400 mb-6") 새 계정을 만들어 시작하세요.

                //- Error Message
                div(*ngIf="errorMsg",
                    class="mb-4 px-3 py-2.5 rounded-lg bg-red-500/10 border border-red-400/20 text-red-300 text-[13px] flex items-center gap-2")
                    svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 20 20", fill="currentColor", class="size-4 shrink-0")
                        path(fill-rule="evenodd", d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z", clip-rule="evenodd")
                    span {{errorMsg}}

                div(class="space-y-4")
                    //- Name
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 이름
                        input(type="text",
                            autocomplete="name",
                            [(ngModel)]="signupData.name",
                            placeholder="홍길동",
                            class="auth-input")

                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 휴대폰 번호
                        input(type="text",
                            autocomplete="tel",
                            [(ngModel)]="signupData.mobile",
                            placeholder="01012345678",
                            class="auth-input")

                    //- Email
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 이메일
                        input(type="email",
                            autocomplete="email",
                            [(ngModel)]="signupData.email",
                            placeholder="name@example.com",
                            class="auth-input")

                    //- Password
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 비밀번호
                        input(type="password",
                            autocomplete="new-password",
                            [(ngModel)]="signupData.password",
                            placeholder="8자 이상 입력",
                            class="auth-input")

                    //- Password Confirm
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 비밀번호 확인
                        input(type="password",
                            autocomplete="new-password",
                            [(ngModel)]="signupData.passwordConfirm",
                            (keyup.enter)="signup()",
                            placeholder="비밀번호 재입력",
                            class="auth-input")

                    //- Signup Button
                    button((click)="signup()",
                        [disabled]="loading",
                        class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg bg-indigo-500 hover:bg-indigo-400 disabled:opacity-50 disabled:cursor-not-allowed text-white text-[13px] font-semibold transition-colors")
                        svg(*ngIf="loading", class="size-4 animate-spin", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24")
                            circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4")
                            path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z")
                        span {{loading ? '처리 중...' : '회원가입'}}

                //- Login Link
                div(class="mt-6 text-center")
                    span(class="text-[13px] text-slate-500") 이미 계정이 있으신가요?
                    | &nbsp;
                    button((click)="switchView('login')",
                        class="text-[13px] text-indigo-400 hover:text-indigo-300 font-medium transition-colors") 로그인

            div(*ngIf="view === 'find-id'")
                h2(class="text-lg font-semibold text-white mb-1") 아이디 찾기
                p(class="text-[13px] text-slate-400 mb-6") 가입 시 입력한 이름과 휴대폰 번호로 아이디를 찾습니다.

                div(class="mb-4 rounded-lg border border-amber-400/20 bg-amber-500/10 px-3 py-2.5 text-[12px] leading-5 text-amber-200")
                    | 현재 로컬 DB에 저장된 계정만 검색합니다. 이전 서버 DB가 없다면 새 회원가입이 필요합니다.

                div(*ngIf="errorMsg",
                    class="mb-4 px-3 py-2.5 rounded-lg bg-red-500/10 border border-red-400/20 text-red-300 text-[13px] flex items-center gap-2")
                    span {{errorMsg}}

                div(*ngIf="successMsg",
                    class="mb-4 px-3 py-2.5 rounded-lg bg-emerald-500/10 border border-emerald-400/20 text-emerald-300 text-[13px] flex items-center gap-2")
                    span {{successMsg}}

                div(class="space-y-4")
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 이름
                        input(type="text", [(ngModel)]="findIdData.name", placeholder="홍길동", class="auth-input")
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 휴대폰 번호
                        input(type="text", [(ngModel)]="findIdData.mobile", (keyup.enter)="findId()", placeholder="01012345678", class="auth-input")
                    button((click)="findId()",
                        [disabled]="loading",
                        class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg bg-indigo-500 hover:bg-indigo-400 disabled:opacity-50 disabled:cursor-not-allowed text-white text-[13px] font-semibold transition-colors")
                        span {{loading ? '확인 중...' : '아이디 찾기'}}

                div(class="mt-6 text-center flex items-center justify-center gap-3")
                    button((click)="switchView('login')", class="text-[13px] text-indigo-400 hover:text-indigo-300 font-medium transition-colors") 로그인으로
                    button((click)="switchView('reset-password')", class="text-[13px] text-slate-400 hover:text-white font-medium transition-colors") 비밀번호 재설정
                    button((click)="switchView('signup')", class="text-[13px] text-slate-400 hover:text-white font-medium transition-colors") 새 회원가입

            div(*ngIf="view === 'reset-password'")
                h2(class="text-lg font-semibold text-white mb-1") 비밀번호 재설정
                p(class="text-[13px] text-slate-400 mb-6") 본인 확인 후 새 비밀번호를 바로 설정합니다.

                div(*ngIf="errorMsg",
                    class="mb-4 px-3 py-2.5 rounded-lg bg-red-500/10 border border-red-400/20 text-red-300 text-[13px] flex items-center gap-2")
                    span {{errorMsg}}

                div(class="space-y-4")
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 이메일
                        input(type="email", [(ngModel)]="resetPasswordData.email", placeholder="name@example.com", class="auth-input")
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 이름
                        input(type="text", [(ngModel)]="resetPasswordData.name", placeholder="홍길동", class="auth-input")
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 휴대폰 번호
                        input(type="text", [(ngModel)]="resetPasswordData.mobile", placeholder="01012345678", class="auth-input")
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 새 비밀번호
                        input(type="password", [(ngModel)]="resetPasswordData.newPassword", placeholder="8자 이상 입력", class="auth-input")
                    div
                        label(class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1.5") 새 비밀번호 확인
                        input(type="password", [(ngModel)]="resetPasswordData.newPasswordConfirm", (keyup.enter)="resetPassword()", placeholder="비밀번호 재입력", class="auth-input")
                    button((click)="resetPassword()",
                        [disabled]="loading",
                        class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg bg-indigo-500 hover:bg-indigo-400 disabled:opacity-50 disabled:cursor-not-allowed text-white text-[13px] font-semibold transition-colors")
                        span {{loading ? '처리 중...' : '비밀번호 재설정'}}

                div(class="mt-6 text-center flex items-center justify-center gap-3")
                    button((click)="switchView('login')", class="text-[13px] text-indigo-400 hover:text-indigo-300 font-medium transition-colors") 로그인으로
                    button((click)="switchView('find-id')", class="text-[13px] text-slate-400 hover:text-white font-medium transition-colors") 아이디 찾기

        //- Footer
        p(class="auth-footer mt-6 text-center text-[11px] text-slate-600") &copy; 2026 STOCK8. Paper first, decisions yours.
