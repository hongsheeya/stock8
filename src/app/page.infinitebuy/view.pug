div(class="firegate-page dx-page")
    div(class="dx-head")
        div(class="dx-title")
            h1 무한매수
            span(class="dx-chip", [class.is-on]="bridge?.connected", [class.is-warn]="bridge?.configured && !bridge?.connected", [class.is-off]="!bridge?.configured")
                i
                | {{bridgeStatusText()}}
        div(class="dx-tools")
            button(class="dx-tool is-primary", (click)="connectFireGateBridge()", [disabled]="bridgeBusy || (!bridge?.configured && !popupReady)") {{bridgeActionText()}}
            button(class="dx-tool", (click)="loadPortfolio(true)", [disabled]="portfolioLoading") 새로고침
            button(class="dx-tool", [class.is-on]="showFireGateFrame", (click)="toggleFireGateFrame()") FireGate 화면
            button(class="dx-tool", (click)="openFireGate()") FireGate 새 탭
            button(class="dx-tool", [class.is-on]="showBridgeTools", (click)="toggleBridgeTools()") 도구

    //- 운용 중인 사이클: 거래이력과 같은 데이터
    div(*ngIf="activeCycles.length > 0", class="ib-cycles")
        a(*ngFor="let c of activeCycles", class="ib-cycle", routerLink="/history")
            strong {{c.symbol}}
            small {{'#' + c.cycle_number}}
            span(class="ib-progress")
                i([style.width.%]="cycleProgress(c)")
            span {{c.current_round || 0}}/{{c.division_count || 0}}
            span ${{(c.total_spent || 0) | number:'1.0-0'}}
            b([class]="tone(c.profit_rate)") {{(c.profit_rate > 0 ? '+' : '') + ((c.profit_rate || 0) | number:'1.2-2')}}%

    div(class="dx-alerts")
        div(*ngIf="error", class="dx-alert is-danger")
            strong 오류
            span {{error}}
        div(*ngIf="bridgeMessage", class="dx-alert is-ok")
            strong 완료
            span {{bridgeMessage}}
        div(*ngIf="!bridge?.configured && !loading", class="dx-alert is-info")
            strong 처음 한 번 연결
            span Google 계정을 한 번 연결하면 이후에는 재로그인 없이 '지금 동기화'를 사용합니다. 인증이 취소되면 다시 연결해야 합니다.

    div(*ngIf="showBridgeTools", class="dx-card ib-tools")
        div(class="dx-card-head")
            h2 FireGate 도구
            small FireGate 사이트 로그인과 Stock8 서버 연결은 별개입니다
        div(class="dx-tools")
            button(class="dx-tool", (click)="loginWithPopup()", [disabled]="bridgeBusy || !popupReady") Google 계정 다시 연결
            button(class="dx-tool", (click)="syncFireGate()", [disabled]="bridgeBusy || !bridge?.configured") 동기화
            button(class="dx-tool", (click)="loginFireGate()") FireGate 로그인

    div(class="firegate-shell")
        div(*ngIf="loading", class="dx-empty") 불러오는 중
        section(*ngIf="!loading && !bridge?.configured", class="bridge-onboarding")
            span STOCK8 × FIRE GATE
            h2 FireGate 계정을 한 번 연결하세요
            p 버튼을 누르면 Google 인증 창이 열립니다. 계정을 선택하고 인증을 마치면 Stock8에 연결을 저장합니다.
            button((click)="loginWithPopup()", [disabled]="bridgeBusy || !popupReady") {{bridgeBusy ? authStage + '…' : (popupReady ? 'Google 계정 연결' : '인증 모듈 준비 중…')}}
            p 앱 내 브라우저에서 인증 창이 열리지 않으면 아래 주소를 일반 Chrome에서 열어주세요. Stock8 로그인 후 같은 버튼으로 연결할 수 있습니다.
            code(style="display:block; overflow-wrap:anywhere; user-select:all") {{browserConnectUrl}}
            p 연결 저장 후 ‘지금 동기화’를 누르세요. FireGate 사이트 자체의 로그인 상태와 Stock8 서버 연결은 별개입니다.
        section(*ngIf="!loading && bridge?.configured", class="dx-card ib-portfolios")
            div(class="dx-card-head")
                h2 FireGate 포트폴리오
                small 저장된 연결로 서버가 불러옵니다 · 로그인 불필요{{portfolioUpdated ? ' · ' + portfolioUpdated : ''}}
            div(*ngIf="portfolioLoading && portfolioItems.length === 0", class="dx-empty") 불러오는 중
            div(*ngIf="!portfolioLoading && portfolioItems.length === 0", class="dx-empty") 포트폴리오가 없습니다. FireGate에서 만든 뒤 동기화하세요.
            div(*ngIf="portfolioItems.length > 0", class="dx-table-wrap")
                table(class="dx-table")
                    thead
                        tr
                            th 종목
                            th(class="num") 회차(T)
                            th(class="num") 보유
                            th(class="num") 평단
                            th(class="num") 현재가
                            th(class="num") 수익률
                            th 오늘 매수
                            th 오늘 매도
                    tbody
                        tr(*ngFor="let p of portfolioItems")
                            td
                                strong {{p.symbol}}
                                small(class="dx-muted ib-sub") {{p.has_cycle ? '#' + (p.cycle_number || 1) + ' · 시드 $' + (p.total_investment | number:'1.0-0') : '대기'}}
                            td(class="num") {{p.has_cycle ? (p.t_value | number:'1.0-2') + ' / ' + p.division_count : '-'}}
                            td(class="num") {{p.total_qty || 0}}주
                            td(class="num") {{p.avg_price > 0 ? '$' + (p.avg_price | number:'1.2-2') : '-'}}
                            td(class="num") {{p.current_price > 0 ? '$' + (p.current_price | number:'1.2-2') : '-'}}
                            td(class="num", [class]="tone(p.profit_rate)") {{p.has_cycle ? ((p.profit_rate > 0 ? '+' : '') + (p.profit_rate | number:'1.2-2') + '%') : '-'}}
                            td
                                div(*ngFor="let o of (p.buy_orders || []).slice(0, 1)", class="ib-order") {{o.order_qty}}주 · ${{o.loc_price | number:'1.2-2'}}
                                    small(class="dx-muted") {{o.label}}
                                div(*ngIf="p.buy_orders?.length > 1", class="ib-order dx-muted") {{dipSummary(p.buy_orders)}}
                                span(*ngIf="!p.buy_orders?.length", class="dx-muted") -
                            td
                                div(*ngFor="let o of p.sell_orders", class="ib-order") {{o.order_qty}}주 · ${{o.price | number:'1.2-2'}}
                                    small(class="dx-muted") {{o.label}}
                                span(*ngIf="!p.sell_orders?.length", class="dx-muted") -
            p(class="ib-note") FireGate 사이트 화면은 브라우저가 외부 사이트 로그인을 자주 끊어서 기본으로 숨겼어요. 수정이 필요하면 'FireGate 새 탭'을 쓰세요. 새 탭에서는 로그인이 유지됩니다.
        iframe(*ngIf="!loading && bridge?.configured && showFireGateFrame",
            id="fireGateIframe",
            src="https://fire-gate.app/",
            title="Fire Gate",
            class="firegate-frame",
            referrerpolicy="no-referrer-when-downgrade",
            allow="clipboard-read; clipboard-write; fullscreen; payment",
            allowfullscreen)
