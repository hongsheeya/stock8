//- Trading Navigation Bar
nav(class="bn-top-nav mx-4 mt-4 mb-2 px-3 py-2 lg:px-4 lg:py-2 flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between relative z-10")
    //- Left: Brand + Menu
    div(class="w-full min-w-0 flex items-center gap-3 lg:gap-6")
        //- Brand
        a(routerLink="/dashboard",
            class="bn-brand flex items-center gap-2 cursor-pointer group")
            div(class="bn-brand-mark")
                span ∞
            span(class="bn-brand-word") STOCK

        //- Nav Links
        div(class="min-w-0 flex-1 overflow-x-auto flex items-center gap-1 w-max")
            a(routerLink="/dashboard", [class]="navClass('/dashboard')")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6")
                span {{t('nav.dashboard')}}
            a(routerLink="/infinite-buy", [class]="navClass('/infinite-buy')")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M10.5 6h3m-7.5 6h15m-12 6h9")
                span 무한매수
            a(*ngIf="effectiveAdminMode",
                routerLink="/daytrade", [class]="navClass('/daytrade')")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M3 13.5 8.25 8.25l4.5 4.5L21 4.5")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M17.25 4.5H21v3.75")
                span 국장 단타
            a(*ngIf="effectiveAdminMode",
                routerLink="/daytrade/us", [class]="navClass('/daytrade/us')")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M13.5 3 21 7.5 13.5 12 6 7.5 13.5 3Z")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M21 12l-7.5 4.5L6 12")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M21 16.5 13.5 21 6 16.5")
                span 미장 단타
            a(*ngIf="effectiveAdminMode",
                routerLink="/simulation", [class]="navClass('/simulation')")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 15a9.065 9.065 0 0 0-6.23.693L5 14.5m14.8.8 1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0 1 12 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5")
                span {{t('nav.simulation')}}
            a(routerLink="/history", [class]="navClass('/history')")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z")
                span {{t('nav.history')}}

    //- Right: Lang Toggle / Market Status / Clock / User
    div(class="w-full lg:w-auto flex items-center justify-between lg:justify-end gap-2 lg:gap-4")
        button(*ngIf="isRealAdmin",
            (click)="toggleAdminPreviewMode()",
            [title]="adminPreviewButtonTitle",
            class="bn-secondary-button flex items-center gap-1.5 px-2.5 py-1 text-xs transition-colors",
            [class.is-active]="adminPreviewUserMode")
            span {{adminPreviewButtonLabel}}

        //- Language Toggle
        div(class="flex items-center gap-1")
            button((click)="toggleLang()",
                class="bn-icon-button flex items-center gap-1 px-2 py-1 transition-colors text-xs")
                span {{lang === 'ko' ? 'KO' : 'EN'}}
            button((click)="toggleThemeMode()",
                class="bn-secondary-button flex items-center gap-1.5 px-2.5 py-1 text-xs transition-colors")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-3.5")
                    path(*ngIf="!isLightTheme", stroke-linecap="round", stroke-linejoin="round", d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 1 0 21.752 15.002Z")
                    path(*ngIf="isLightTheme", stroke-linecap="round", stroke-linejoin="round", d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.364 6.364-1.06-1.06M7.697 6.697l-1.06-1.06m12.727 0-1.06 1.06M7.697 17.303l-1.06 1.06M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z")
                span {{themeModeLabel}}

        //- Market Time
        div(class="hidden sm:flex items-center gap-2 text-xs")
            div(class="flex items-center gap-1")
                div(class="bn-market-dot", [class.is-open]="isMarketOpen()")
                span(class="bn-muted") {{isMarketOpen() ? t('nav.market_open') : t('nav.market_closed')}}
            span(class="bn-divider") |
            span(class="bn-clock tabular-nums") {{now | date:'HH:mm:ss'}}

        //- User / Settings
        div(class="relative flex items-center gap-2", (click)="$event.stopPropagation()")
            button((click)="goToSettings()",
                [class]="settingsButtonClass()")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z")

            button((click)="toggleUserMenu()",
                [class]="avatarButtonClass()")
                | {{service.auth.session?.name?.charAt(0) || '?'}}

            div(*ngIf="userMenuOpen",
                class="bn-menu absolute top-full right-0 mt-2 w-48 overflow-hidden z-50",
                (click)="$event.stopPropagation()")
                a((click)="goToSettings()",
                    class="dropdown-item flex items-center gap-3 px-4 py-3 text-sm transition-colors cursor-pointer")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z")
                    span 설정

                div(class="border-t border-white/10")

                button((click)="handleLogout()",
                    class="dropdown-item danger w-full flex items-center gap-3 px-4 py-3 text-sm transition-colors")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M18 12H9m0 0 3-3m-3 3 3 3")
                    span {{t('nav.logout')}}
