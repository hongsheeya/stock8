//- ============================================================
//- Settings: one left-aligned column (header, tabs, content)
//- ============================================================

div(class="dx-head st-head")
    div(class="dx-title")
        h1 설정
        span(*ngIf="accountContext", class="dx-chip", [class.is-live]="!isMock") {{isMock ? '모의투자' : '실계좌'}}
    div(class="dx-tools")
        div(*ngIf="accountContext?.paper_subscribed && !isInfiniteBuyMode()", class="dx-seg", title="실투자와 모의투자는 잔고·거래이력·설정을 공유하지 않습니다")
            button(type="button", [class.is-on]="accountContext.mode === 'LIVE'", (click)="accountContext.mode !== 'LIVE' && switchAccount('LIVE')") 실투자
            button(type="button", [class.is-on]="accountContext.mode === 'PAPER'", (click)="accountContext.mode !== 'PAPER' && switchAccount('PAPER')") 모의투자
        button(*ngIf="accountContext && !accountContext.paper_subscribed && !isInfiniteBuyMode()", type="button", class="dx-tool", (click)="subscribePaper()", [disabled]="loading") 모의투자 신청
        a(*ngIf="accountContext && !isMock", class="dx-tool", routerLink="/settings/live") 실투자 주문 허용

div(*ngIf="!accountContext", role="status", class="dx-alert is-info")
    strong 확인 중
    span {{loadError || '투자 계정을 확인하고 있습니다…'}}

nav(class="dx-tabs st-tabs")
    button(*ngIf="!isInfiniteBuyMode()", type="button", (click)="switchTab('api')", [class]="tabClass('api')") 증권사 연결
    button((click)="switchTab('watchlist')", type="button", [class]="tabClass('watchlist')") {{t('set.watchlist')}}
    button((click)="switchTab('strategy')", type="button", [class]="tabClass('strategy')") 매매전략
    button(*ngIf="!isInfiniteBuyMode() && showDaytradeSettingsTab()", type="button", (click)="switchTab('risk')", [class]="tabClass('risk')") 단타
    button(*ngIf="!isInfiniteBuyMode()", type="button", (click)="switchTab('account')", [class]="tabClass('account')") 계정

//- ============================================================
//- TAB: Broker connection
//- ============================================================
div(*ngIf="tab === 'api' && accountContext")
    div(*ngIf="loadError", class="dx-alert is-danger") {{loadError}}
    section(class="st-card")
        header(class="st-card-head")
            div
                h2 증권사 연결
                p {{isMock ? 'KIS 모의투자 서버에 연결합니다.' : 'KIS 실전 서버에 연결합니다. 실제 주문은 실투자 주문 허용에서 따로 켭니다.'}}
            span(class="st-status", [class.is-ok]="paperReady || testOk", [class.is-error]="!(paperReady || testOk) && testResult") {{paperReady || testOk ? '연결됨' : (testResult ? '확인 필요' : '확인 전')}}

        div(class="st-form")
            div(class="st-row")
                label(for="st-broker") 증권사
                div(class="st-field")
                    select(id="st-broker", [ngModel]="brokerProvider", (ngModelChange)="selectBrokerById($event)")
                        option(*ngFor="let item of brokerOptions", [value]="item.id", [disabled]="item.enabled !== true") {{item.name}}

            ng-container(*ngIf="brokerProvider === 'kis'")
                div(class="st-row")
                    label(for="st-app-key") {{t('set.app_key')}}
                    div(class="st-field")
                        input(id="st-app-key", [(ngModel)]="appKey", type="text", autocomplete="off", placeholder="PS로 시작하는 앱키")
                div(class="st-row")
                    label(for="st-app-secret") {{t('set.app_secret')}}
                    div(class="st-field st-field-inline")
                        input(id="st-app-secret", [(ngModel)]="appSecret", [type]="showSecret ? 'text' : 'password'", autocomplete="off")
                        button(type="button", class="st-btn", (click)="showSecret = !showSecret; service.render();") {{showSecret ? '숨기기' : '보기'}}
                div(class="st-row")
                    label(for="st-account") {{t('set.account_no')}}
                    div(class="st-field")
                        input(id="st-account", [(ngModel)]="accountNo", type="text", maxlength="11", placeholder="12345678-01")
                        small 계좌번호 8자리와 상품코드 2자리를 하이픈으로 이어서 입력합니다.

            ng-container(*ngIf="brokerProvider === 'toss'")
                div(class="st-row")
                    label(for="st-toss-key") API key
                    div(class="st-field")
                        input(id="st-toss-key", [(ngModel)]="tossClientId", type="text", autocomplete="off", placeholder="tsck_...")
                        small 토스증권 WTS 설정 → Open API의 api key를 붙여넣습니다.
                div(class="st-row")
                    label(for="st-toss-secret") Secret key
                    div(class="st-field st-field-inline")
                        input(id="st-toss-secret", [(ngModel)]="tossClientSecret", [type]="showSecret ? 'text' : 'password'", autocomplete="off", placeholder="tssk_...")
                        button(type="button", class="st-btn", (click)="showSecret = !showSecret; service.render();") {{showSecret ? '숨기기' : '보기'}}
                div(class="st-row")
                    label(for="st-toss-seq") accountSeq
                    div(class="st-field")
                        input(id="st-toss-seq", [(ngModel)]="tossAccountSeq", type="text", placeholder="비워두면 연결할 때 자동으로 채웁니다")

        div(class="st-actions")
            button(type="button", class="st-btn is-primary", (click)="saveApiSettings()", [disabled]="loading") {{loading ? '확인 중…' : '저장 후 연결 확인'}}
            a(class="st-link", href="/assets/InfinityStock_User_Guide.pdf", download="InfinityStock_User_Guide.pdf", target="_blank") 사용 설명서(PDF)

        div(*ngIf="testResult || readinessVerifiedAt", class="st-result", [class.is-error]="!(paperReady || testOk) && testResult")
            span {{testResult || '연결을 확인했습니다.'}}
            small(*ngIf="readinessVerifiedAt") 마지막 확인 {{readinessTimeLabel()}}
        ul(*ngIf="apiDiagnostics.length > 0", class="st-diag")
            li(*ngFor="let item of apiDiagnostics", [class.is-error]="item.success === false")
                span {{item.success === false ? '실패' : '정상'}}
                | {{item.step ? item.step + ' · ' : ''}}{{item.message || item}}

        p(class="st-note") API 키와 계좌번호는 이 투자 계정에만 저장됩니다. 연결 확인만으로는 주문이 나가지 않습니다.

//- ============================================================
//- TAB: Account
//- ============================================================
div(*ngIf="tab === 'account' && accountContext")
    section(class="st-card")
        header(class="st-card-head")
            div
                h2 계정 정보
        div(class="st-form")
            div(class="st-row")
                label(for="st-login-id") 아이디
                div(class="st-field")
                    input(id="st-login-id", [(ngModel)]="accountLoginId", type="text")
            div(class="st-row")
                label(for="st-email") 이메일
                div(class="st-field")
                    input(id="st-email", [(ngModel)]="accountEmail", type="email")
            div(class="st-row")
                label 사용자 ID
                div(class="st-field")
                    input([value]="accountUserId", type="text", disabled)
        div(class="st-actions")
            button(type="button", class="st-btn is-primary", (click)="saveAccountProfile()") 저장

    section(class="st-card")
        header(class="st-card-head")
            div
                h2 비밀번호 변경
        div(class="st-form")
            div(class="st-row")
                label(for="st-pw-now") 현재 비밀번호
                div(class="st-field")
                    input(id="st-pw-now", [(ngModel)]="currentPassword", type="password", autocomplete="current-password")
            div(class="st-row")
                label(for="st-pw-new") 새 비밀번호
                div(class="st-field")
                    input(id="st-pw-new", [(ngModel)]="newPassword", type="password", autocomplete="new-password")
            div(class="st-row")
                label(for="st-pw-confirm") 새 비밀번호 확인
                div(class="st-field")
                    input(id="st-pw-confirm", [(ngModel)]="confirmPassword", type="password", autocomplete="new-password")
        div(class="st-actions")
            button(type="button", class="st-btn", (click)="changeAccountPassword()", [disabled]="changingPassword") {{changingPassword ? '변경 중…' : '비밀번호 변경'}}

//- ============================================================
//- TAB: Risk Settings
//- ============================================================
div(*ngIf="tab === 'risk' && showDaytradeSettingsTab()")
    div(class="glass-card p-6 max-w-2xl")
        h2(class="text-sm font-semibold text-white mb-5") 단타 리스크 설정

        div(*ngIf="effectiveAdminMode()", class="mb-5 rounded-xl border border-amber-400/25 bg-amber-500/10 px-4 py-4")
            div(class="flex items-start justify-between gap-4")
                div
                    h3(class="text-[13px] font-semibold text-amber-200") 관리자 단타 기능
                    p(class="mt-1 text-[11px] text-amber-100/75") 전역 ON은 단타 메뉴와 설정 접근만 열어줍니다. 사용자별 자동매매는 절대 함께 켜지지 않습니다.
                button((click)="daytradeFeatureEnabled = !daytradeFeatureEnabled; service.render();",
                    class="relative mt-0.5 h-5 w-10 rounded-full transition-colors",
                    [class]="daytradeFeatureEnabled ? 'bg-amber-400' : 'bg-slate-600'")
                    div(class="absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-transform",
                        [class]="daytradeFeatureEnabled ? 'translate-x-5' : 'translate-x-0.5'")
            p(class="mt-4 text-sm") 단타는 관리자 계정 전용입니다. 일반 사용자 인증 목록으로 권한을 열 수 없습니다.
            div(class="mt-3 flex justify-end")
                button((click)="saveDaytradeAdminSettings()",
                    class="px-4 py-2 rounded-lg bg-amber-400/20 border border-amber-300/35 text-amber-100 text-[13px] font-semibold hover:bg-amber-400/30 transition-colors")
                    | 관리자 설정 저장

        div(*ngIf="!effectiveAdminMode() && daytradeFeatureEnabled && daytradeUserAuthorized && !daytradeUserConfirmed", class="mb-5 rounded-xl border border-red-400/25 bg-red-500/10 px-4 py-4")
            h3(class="text-[13px] font-semibold text-red-200") 단타 위험 확인 필요
            p(class="mt-1 text-[11px] leading-5 text-red-100/75") 단타는 손실 가능성이 크며 자동매매가 켜져도 수익이 보장되지 않습니다. 사용자가 직접 손실 책임을 확인해야 활성화할 수 있습니다.
            div(class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center")
                input([(ngModel)]="daytradeConfirmationInput",
                    type="text",
                    [placeholder]="daytradeConfirmationPhrase",
                    class="flex-1 rounded-lg border border-red-300/20 bg-black/10 px-3 py-2 text-[13px] text-red-50 placeholder-red-100/35 focus:outline-none focus:border-red-300/60")
                button((click)="confirmDaytradeWarning()",
                    class="px-4 py-2 rounded-lg bg-red-400/20 border border-red-300/35 text-red-100 text-[13px] font-semibold hover:bg-red-400/30 transition-colors")
                    | 확인 문구 저장

        div(*ngIf="!daytradeFeatureEnabled || !daytradeUserAuthorized || !daytradeUserConfirmed", class="mb-5 rounded-xl border border-white/10 bg-white/5 px-4 py-3")
            h3(class="text-[13px] font-semibold text-slate-200") 단타 기능 정지됨
            p(class="mt-1 text-[11px] leading-5 text-slate-400") 현재 단타 자동매매와 수동 매도는 차단되어 있습니다. 관리자가 전역 기능을 켜고 사용자를 인증한 뒤, 일반 사용자가 '{{daytradeConfirmationPhrase}}' 문구를 입력해야 사용할 수 있습니다.

        div(class="space-y-5")
            div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                div
                    label(class="block text-xs font-medium text-slate-400 mb-1") 국장 단타 기본 시드 (KRW)
                    input([(ngModel)]="daytradeDefaultSeedKrw",
                        type="number",
                        step="100000",
                        min="100000",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-indigo-400/50 transition-colors")
                    p(class="text-[10px] text-slate-600 mt-1") 스케줄러와 국장 단타 화면의 기본 요청 시드입니다.
                    div(class="flex flex-wrap gap-2 mt-3")
                        button((click)="setSeedPreset('KS', 1000000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩1,000,000
                        button((click)="setSeedPreset('KS', 3000000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩3,000,000
                        button((click)="setSeedPreset('KS', 5000000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩5,000,000
                div
                    label(class="block text-xs font-medium text-slate-400 mb-1") 미장 단타 기본 시드 (KRW)
                    input([(ngModel)]="daytradeUsDefaultSeedKrw",
                        type="number",
                        step="100000",
                        min="100000",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-indigo-400/50 transition-colors")
                    p(class="text-[10px] text-slate-600 mt-1") 미장 자동순환과 미장 단타 화면의 기본 요청 시드입니다.
                    div(class="flex flex-wrap gap-2 mt-3")
                        button((click)="setSeedPreset('US', 1000000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩1,000,000
                        button((click)="setSeedPreset('US', 3000000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩3,000,000
                        button((click)="setSeedPreset('US', 5000000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩5,000,000

            div(class="flex items-center justify-between px-3 py-3 rounded-lg bg-white/5 border border-white/10")
                div
                    span(class="text-[13px] font-medium text-slate-200") 국내 단타 자동순환
                    p(class="text-[11px] text-slate-500 mt-0.5") 꺼두면 아무 작업도 하지 않습니다. 수동 운용만 유지됩니다.
                button((click)="toggleDaytradeAutoEnabled()",
                    [disabled]="!daytradeFeatureEnabled || !daytradeUserAuthorized || !daytradeUserConfirmed",
                    class="relative w-10 h-5 rounded-full transition-colors",
                    [class]="daytradeAutoEnabled ? 'bg-indigo-500' : 'bg-slate-600 disabled:opacity-50'")
                    div(class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform",
                        [class]="daytradeAutoEnabled ? 'translate-x-5' : 'translate-x-0.5'")

            div(class="flex items-center justify-between px-3 py-3 rounded-lg bg-white/5 border border-white/10")
                div
                    span(class="text-[13px] font-medium text-slate-200") 미장 단타 자동순환
                    p(class="text-[11px] text-slate-500 mt-0.5") 꺼두면 아무 작업도 하지 않습니다. 수동 운용만 유지됩니다.
                button((click)="toggleDaytradeUsAutoEnabled()",
                    [disabled]="!daytradeFeatureEnabled || !daytradeUserAuthorized || !daytradeUserConfirmed",
                    class="relative w-10 h-5 rounded-full transition-colors",
                    [class]="daytradeUsAutoEnabled ? 'bg-blue-500' : 'bg-slate-600 disabled:opacity-50'")
                    div(class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform",
                        [class]="daytradeUsAutoEnabled ? 'translate-x-5' : 'translate-x-0.5'")

            div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                div
                    label(class="block text-xs font-medium text-slate-400 mb-1") 일일 손실 제한 (KRW)
                    input([(ngModel)]="daytradeDailyLossLimitKrw",
                        type="number",
                        step="10000",
                        min="0",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-red-400/50 transition-colors")
                    p(class="text-[10px] text-slate-600 mt-1") 도달하면 신규 매수만 차단하고 기존 포지션 청산 감시는 유지합니다. 0은 제한 없음입니다.
                    div(class="flex flex-wrap gap-2 mt-3")
                        button((click)="setDailyLossPreset(30000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩30,000
                        button((click)="setDailyLossPreset(50000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩50,000
                        button((click)="setDailyLossPreset(100000)", class="preset-outline-button px-2 py-1 rounded text-[11px] bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:bg-white/10 transition-colors") ₩100,000
                div
                    label(class="block text-xs font-medium text-slate-400 mb-1") 최대 감시 종목 수
                    div(class="flex items-center gap-3")
                        input([(ngModel)]="daytradeAutoMaxSymbols",
                            type="range", min="1", max="40", step="1",
                            class="flex-1 accent-indigo-500")
                        span(class="text-sm font-medium text-white w-10 text-right") {{daytradeAutoMaxSymbols}}
                    p(class="text-[10px] text-slate-600 mt-1") 보유 종목을 포함해 동시에 자동 점검할 국내 단타 종목 수입니다.

            div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                div
                    label(class="block text-xs font-medium text-slate-400 mb-1") 진입 성향
                    select([(ngModel)]="daytradeEntryAggressiveness",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-indigo-400/50 transition-colors")
                        option(value="defensive") 방어
                        option(value="balanced") 균형
                        option(value="aggressive") 적극
                    p(class="text-[10px] text-slate-600 mt-1") 균형/적극은 1차·2차 기준가 근처에서 일부 탐색 진입을 허용합니다.
                div
                    div(class="flex items-center justify-between px-3 py-3 rounded-lg bg-white/5 border border-white/10")
                        div
                            span(class="text-[13px] font-medium text-slate-200") 탐색 진입
                            p(class="text-[11px] text-slate-500 mt-0.5") 기준가 근처면 배정시드 일부로 먼저 진입합니다.
                        button((click)="daytradeProbeEntryEnabled = !daytradeProbeEntryEnabled; service.render();",
                            class="relative w-10 h-5 rounded-full transition-colors",
                            [class]="daytradeProbeEntryEnabled ? 'bg-indigo-500' : 'bg-slate-600'")
                            div(class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform",
                                [class]="daytradeProbeEntryEnabled ? 'translate-x-5' : 'translate-x-0.5'")
                    div(*ngIf="daytradeProbeEntryEnabled", class="mt-3")
                        label(class="block text-xs font-medium text-slate-400 mb-1") 탐색 진입 비율
                        div(class="flex items-center gap-3")
                            input([(ngModel)]="daytradeProbeEntryRatio",
                                type="range", min="0.05", max="0.8", step="0.05",
                                class="flex-1 accent-indigo-500")
                            span(class="text-sm font-medium text-white w-12 text-right") {{((daytradeProbeEntryRatio || 0) * 100) | number:'1.0-0'}}%

            div(class="pt-4 border-t border-white/10 space-y-4")
                div(class="flex items-start justify-between gap-4")
                    div
                        h3(class="text-sm font-semibold text-white") 잭팟 청산
                        p(class="text-[11px] text-slate-500 mt-1") 국장 현재 목표 +{{daytradeJackpotTakeProfitPct | number:'1.0-2'}}%, 예약 시작 약 +{{jackpotPreSellProfitPct() | number:'1.2-2'}}%
                    span(class="shrink-0 rounded-lg border border-emerald-400/20 bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-300") ACTIVE
                div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                    div
                        label(class="block text-xs font-medium text-slate-400 mb-1") 국장 전량청산 수익률 (%)
                        input([(ngModel)]="daytradeJackpotTakeProfitPct",
                            type="number",
                            step="0.1",
                            min="0.1",
                            max="20",
                            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-emerald-400/50 transition-colors")
                    div
                        label(class="block text-xs font-medium text-slate-400 mb-1") 국장 예약 시작 간격 (%)
                        input([(ngModel)]="daytradeJackpotPreSellGapPct",
                            type="number",
                            step="0.1",
                            min="0",
                            max="5",
                            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-emerald-400/50 transition-colors")
                        p(class="text-[10px] text-slate-600 mt-1") 목표가보다 이 비율만큼 아래부터 지정가 예약 매도를 준비합니다.
                    div
                        label(class="block text-xs font-medium text-slate-400 mb-1") 미장 1차 익절 (%)
                        input([(ngModel)]="daytradeUsJackpotTakeProfitPct",
                            type="number",
                            step="0.1",
                            min="0.1",
                            max="50",
                            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-sky-400/50 transition-colors")
                    div
                        label(class="block text-xs font-medium text-slate-400 mb-1") 미장 2차 익절 (%)
                        input([(ngModel)]="daytradeUsJackpot2TakeProfitPct",
                            type="number",
                            step="0.1",
                            min="0.1",
                            max="100",
                            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-sky-400/50 transition-colors")

            div(class="pt-2")
                button((click)="saveParams()",
                    class="px-4 py-2 rounded-lg bg-red-500/20 border border-red-400/30 text-red-300 text-[13px] font-medium hover:bg-red-500/30 transition-colors")
                    | 리스크 설정 저장

//- ============================================================
//- TAB: Watchlist
//- ============================================================
div(*ngIf="tab === 'watchlist'")
    div(class="glass-card p-6")
        h2(class="text-sm font-semibold text-white mb-5") {{t('set.etf_watchlist')}}

        //- Add Form
        div(class="mb-6 pb-5 border-b border-white/5")
            div(class="flex items-end gap-3")
                //- Symbol (with search)
                div(class="flex-1 relative")
                    label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.symbol')}}
                    input([(ngModel)]="newSymbol",
                        (input)="onSymbolInput()",
                        (blur)="closeSearchResults()",
                        type="text",
                        placeholder="TQQQ",
                        autocomplete="off",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-400/50 transition-colors")
                    //- Search Dropdown
                    div(*ngIf="showSearchResults",
                        class="absolute top-full left-0 right-0 mt-1 z-10 rounded-lg bg-slate-800 border border-white/10 shadow-xl overflow-hidden")
                        div(*ngIf="searchLoading", class="px-3 py-2 text-xs text-slate-500") {{t('common.loading')}}
                        div(*ngIf="!searchLoading && searchResults.length === 0",
                            class="px-3 py-2 text-xs text-slate-500") {{t('set.no_search_result')}}
                        button(*ngFor="let r of searchResults",
                            (mousedown)="selectSearchResult(r)",
                            class="w-full px-3 py-2 flex items-center gap-3 hover:bg-white/10 transition-colors text-left")
                            span(class="text-[13px] font-bold text-white") {{r.symbol}}
                            span(class="text-xs px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300") {{r.exchange_label}}
                            span(class="text-xs text-slate-400 truncate flex-1") {{r.name}}
                            span(class="text-xs text-slate-500") ${{r.price | number:'1.2-2'}}

                //- Exchange
                div(style="width: 110px;")
                    label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.exchange')}}
                    select([(ngModel)]="newExchange",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-indigo-400/50 transition-colors")
                        option(value="NASD") NASDAQ
                        option(value="NYSE") NYSE
                        option(value="AMEX") AMEX

                //- Name
                div(class="flex-1")
                    label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.name_opt')}}
                    input([(ngModel)]="newName",
                        type="text",
                        placeholder="ProShares UltraPro QQQ",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-400/50 transition-colors")

                //- Investment
                div(style="width: 120px;")
                    label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.investment_usd')}}
                    input([(ngModel)]="newInvestment",
                        type="number",
                        class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-indigo-400/50 transition-colors")

                //- Add Button
                button((click)="addSymbol()",
                    class="px-4 py-2 rounded-lg bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-[13px] font-medium hover:bg-indigo-500/30 transition-colors whitespace-nowrap")
                    | {{t('set.add')}}

            div(class="mt-2 text-[10px] text-slate-600") {{t('set.search_hint')}}

        //- List
        div(*ngIf="watchlist.length === 0", class="text-center py-8")
            p(class="text-[13px] text-slate-500") {{t('set.no_watchlist')}}
            p(class="text-xs text-slate-600 mt-1") {{t('set.no_watchlist_desc')}}

        div(class="space-y-2")
            div(*ngFor="let item of watchlist",
                class="flex items-center gap-4 px-4 py-3 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 transition-colors")
                //- Symbol & Name
                div(class="w-32")
                    div(class="flex items-center gap-1.5")
                        span(class="text-[13px] font-bold text-white") {{item.symbol}}
                        span(class="text-[9px] px-1 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-medium") {{item.exchange || 'NASD'}}
                    div(class="text-[11px] text-slate-500 truncate") {{item.name || '-'}}

                //- Investment
                div(class="w-28")
                    label(class="text-[10px] text-slate-500") 투자금
                    input([(ngModel)]="item.total_investment",
                        (blur)="updateWatchlistItem(item)",
                        type="number",
                        class="w-full mt-0.5 px-2 py-1 rounded bg-white/5 border border-white/5 text-xs text-slate-300 focus:outline-none focus:border-indigo-400/50")

                //- Division
                div(class="w-20")
                    label(class="text-[10px] text-slate-500 uppercase") {{t('set.splits')}}
                    input([(ngModel)]="item.division_count",
                        (blur)="updateWatchlistItem(item)",
                        type="number",
                        class="w-full mt-0.5 px-2 py-1 rounded bg-white/5 border border-white/5 text-xs text-slate-300 focus:outline-none focus:border-indigo-400/50")

                //- Target Profit
                div(class="w-20")
                    label(class="text-[10px] text-slate-500 uppercase") {{t('set.target_pct')}}
                    input([(ngModel)]="item.target_profit",
                        (blur)="updateWatchlistItem(item)",
                        type="number",
                        class="w-full mt-0.5 px-2 py-1 rounded bg-white/5 border border-white/5 text-xs text-slate-300 focus:outline-none focus:border-indigo-400/50")

                //- Cycle Mode
                div(class="w-24")
                    label(class="text-[10px] text-slate-500 uppercase") {{t('set.cycle_mode')}}
                    select([(ngModel)]="item.cycle_mode",
                        (change)="updateWatchlistItem(item)",
                        class="w-full mt-0.5 px-2 py-1 rounded bg-white/5 border border-white/5 text-xs text-slate-300 focus:outline-none focus:border-indigo-400/50")
                        option(value="auto") {{t('set.auto')}}
                        option(value="confirm") {{t('set.confirm')}}
                        option(value="manual") {{t('set.manual')}}

                div(class="flex-1")

                //- Active Toggle
                button((click)="toggleSymbol(item)",
                    class="relative w-9 h-5 rounded-full transition-colors",
                    [class]="item.is_active ? 'bg-emerald-500' : 'bg-slate-600'")
                    div(class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform",
                        [class]="item.is_active ? 'translate-x-4' : 'translate-x-0.5'")

                //- Remove
                button((click)="removeSymbol(item.id)",
                    class="text-slate-600 hover:text-red-400 transition-colors p-1")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                        path(stroke-linecap="round", stroke-linejoin="round", d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0")

        //- Cycle Mode Legend
        div(class="mt-4 pt-4 border-t border-white/5")
            div(class="flex items-center gap-4")
                span(class="text-[11px] text-slate-500") {{t('set.cycle_modes')}}
                div(class="flex items-center gap-1.5")
                    div(class="w-2 h-2 rounded-full bg-emerald-400")
                    span(class="text-[11px] text-slate-400") {{t('set.auto_desc')}}
                div(class="flex items-center gap-1.5")
                    div(class="w-2 h-2 rounded-full bg-amber-400")
                    span(class="text-[11px] text-slate-400") {{t('set.confirm_desc')}}
                div(class="flex items-center gap-1.5")
                    div(class="w-2 h-2 rounded-full bg-indigo-400")
                    span(class="text-[11px] text-slate-400") {{t('set.manual_desc')}}

//- ============================================================
//- TAB: Strategy
//- ============================================================
div(*ngIf="tab === 'strategy'")
    div(class="glass-card p-6 max-w-2xl")
        h2(class="text-sm font-semibold text-white mb-5") 매매전략

        div(class="space-y-6")
            div(class="st-mode", [class.is-default]="isFiregateDefault()")
                div
                    strong {{isFiregateDefault() ? 'FireGate 그대로 운용 중' : '고급 주문 설정 사용 중'}}
                    p(*ngIf="isFiregateDefault()") 매수·매도 가격, 분할 수량, LOC/지정가 구분을 FireGate 표와 동일하게 예약합니다.
                    p(*ngIf="!isFiregateDefault()") 매수 {{buyMethod === 'loc' ? 'LOC 고정' : 'FireGate 그대로'}} · 매도 {{sellMethod === 'loc' ? 'LOC 고정' : 'FireGate 그대로'}}. 가격과 수량은 FireGate 표를 따르고 주문 유형만 바뀝니다.
                button(*ngIf="!isFiregateDefault()", type="button", class="st-btn",
                    (click)="buyMethod = 'firegate'; sellMethod = 'firegate'; service.render();") FireGate 기본으로 되돌리기

            div(class="rounded-xl border border-white/10 bg-white/5")
                button(type="button",
                    class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left",
                    (click)="advancedOrderSettingsOpen = !advancedOrderSettingsOpen; service.render();")
                    div
                        h3(class="text-[13px] font-semibold text-slate-200") 고급 LOC 주문 설정
                        p(class="mt-0.5 text-[11px] text-slate-500") 필요할 때만 FireGate 주문방식을 LOC 중심으로 덮어씁니다.
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor",
                        class="size-4 text-slate-400 transition-transform",
                        [class.rotate-180]="advancedOrderSettingsOpen")
                        path(stroke-linecap="round", stroke-linejoin="round", d="m19.5 8.25-7.5 7.5-7.5-7.5")
                div(*ngIf="advancedOrderSettingsOpen", class="space-y-4 border-t border-white/10 px-4 py-4")
                    div
                        label(class="block text-xs font-medium text-slate-400 mb-3") 매수 주문 방식
                        div(class="grid grid-cols-1 sm:grid-cols-2 gap-3")
                            button((click)="setBuyMethod('firegate')",
                                class="p-4 rounded-lg border text-left transition-all",
                                [class]="buyMethod === 'firegate' ? 'bg-emerald-500/10 border-emerald-400/30' : 'bg-white/5 border-white/10 hover:border-white/20'")
                                div(class="flex items-center gap-2 mb-2")
                                    div(class="w-3 h-3 rounded-full border-2 flex items-center justify-center",
                                        [class]="buyMethod === 'firegate' ? 'border-emerald-400' : 'border-slate-600'")
                                        div(*ngIf="buyMethod === 'firegate'", class="w-1.5 h-1.5 rounded-full bg-emerald-400")
                                    span(class="text-[13px] font-medium",
                                        [class]="buyMethod === 'firegate' ? 'text-emerald-300' : 'text-slate-300'")
                                        | FireGate 매수 그대로
                                p(class="text-[11px] text-slate-500 ml-5") FireGate 표의 매수 라인을 그대로 예약합니다.
                            button((click)="setBuyMethod('loc')",
                                class="p-4 rounded-lg border text-left transition-all",
                                [class]="buyMethod === 'loc' ? 'bg-cyan-500/10 border-cyan-400/30' : 'bg-white/5 border-white/10 hover:border-white/20'")
                                div(class="flex items-center gap-2 mb-2")
                                    div(class="w-3 h-3 rounded-full border-2 flex items-center justify-center",
                                        [class]="buyMethod === 'loc' ? 'border-cyan-400' : 'border-slate-600'")
                                        div(*ngIf="buyMethod === 'loc'", class="w-1.5 h-1.5 rounded-full bg-cyan-400")
                                    span(class="text-[13px] font-medium",
                                        [class]="buyMethod === 'loc' ? 'text-cyan-300' : 'text-slate-300'")
                                        | LOC 매수 고정
                                p(class="text-[11px] text-slate-500 ml-5") 1회차도 LOC 예약으로 고정합니다.

                    div
                        label(class="block text-xs font-medium text-slate-400 mb-3") 매도 주문 방식
                        div(class="grid grid-cols-1 sm:grid-cols-2 gap-3")
                            button((click)="setSellMethod('firegate')",
                                class="p-4 rounded-lg border text-left transition-all",
                                [class]="sellMethod === 'firegate' ? 'bg-emerald-500/10 border-emerald-400/30' : 'bg-white/5 border-white/10 hover:border-white/20'")
                                div(class="flex items-center gap-2 mb-2")
                                    div(class="w-3 h-3 rounded-full border-2 flex items-center justify-center",
                                        [class]="sellMethod === 'firegate' ? 'border-emerald-400' : 'border-slate-600'")
                                        div(*ngIf="sellMethod === 'firegate'", class="w-1.5 h-1.5 rounded-full bg-emerald-400")
                                    span(class="text-[13px] font-medium",
                                        [class]="sellMethod === 'firegate' ? 'text-emerald-300' : 'text-slate-300'")
                                        | FireGate 매도 그대로
                                p(class="text-[11px] text-slate-500 ml-5") LOC와 지정가 분할 매도를 FireGate 표와 동일하게 예약합니다.
                            button((click)="setSellMethod('loc')",
                                class="p-4 rounded-lg border text-left transition-all",
                                [class]="sellMethod === 'loc' ? 'bg-cyan-500/10 border-cyan-400/30' : 'bg-white/5 border-white/10 hover:border-white/20'")
                                div(class="flex items-center gap-2 mb-2")
                                    div(class="w-3 h-3 rounded-full border-2 flex items-center justify-center",
                                        [class]="sellMethod === 'loc' ? 'border-cyan-400' : 'border-slate-600'")
                                        div(*ngIf="sellMethod === 'loc'", class="w-1.5 h-1.5 rounded-full bg-cyan-400")
                                    span(class="text-[13px] font-medium",
                                        [class]="sellMethod === 'loc' ? 'text-cyan-300' : 'text-slate-300'")
                                        | LOC 매도 고정
                                p(class="text-[11px] text-slate-500 ml-5") FireGate의 매도 가격과 수량은 유지하고 주문방식만 모두 LOC로 예약합니다.

            //- FireGate sell split (drives the real reservations)
            div(class="st-split")
                strong 분할 매도
                p FireGate 매도표의 가격은 그대로 두고, ★ LOC로 파는 비중과 나머지 목표가만 바꿉니다. 하락장에서 일찍 판 현금은 다음 분할 매수에 다시 쓰입니다.
                div(class="st-split-row")
                    label(for="st-star-ratio") ★ LOC 매도 비중
                    select(id="st-star-ratio", [(ngModel)]="starSellRatio")
                        option(value="") FireGate 기본 (1/4)
                        option(value="0.5") 1/2
                        option(value="0.75") 3/4 (추천 · 낙폭 감소)
                        option(value="1") 전량
                div(class="st-split-row")
                    label(for="st-target-pct") 나머지 목표가
                    div(class="st-split-input")
                        input(id="st-target-pct", [(ngModel)]="targetSellPct", type="number", min="1", max="100", step="1", placeholder="FireGate 기본 (+20%)")
                        span %
                small SOXL 2018~2026 일봉 시뮬: 기본 +254% · 최대낙폭 34% / 3/4 · +25% +164% · 최대낙폭 14%

            //- Sell Strategy Selection
            div
                label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.sell_strategy')}}
                p(class="st-hint") 실계좌 예약 주문은 위의 분할 매도 설정을 따릅니다. 아래 선택은 예약 주문이 아닌 즉시 판단 경로에만 쓰입니다.
                div(class="grid grid-cols-1 md:grid-cols-3 gap-3")
                    //- FireGate Default
                    button((click)="setStrategy('firegate')",
                        class="p-4 rounded-lg border text-left transition-all",
                        [class]="sellStrategy === 'firegate' ? 'bg-cyan-500/10 border-cyan-400/30' : 'bg-white/5 border-white/10 hover:border-white/20'")
                        div(class="flex items-center gap-2 mb-2")
                            div(class="w-3 h-3 rounded-full border-2 flex items-center justify-center",
                                [class]="sellStrategy === 'firegate' ? 'border-cyan-400' : 'border-slate-600'")
                                div(*ngIf="sellStrategy === 'firegate'",
                                    class="w-1.5 h-1.5 rounded-full bg-cyan-400")
                            span(class="text-[13px] font-medium",
                                [class]="sellStrategy === 'firegate' ? 'text-cyan-300' : 'text-slate-300'")
                                | {{t('set.strategy_firegate')}}
                        p(class="text-[11px] text-slate-500 ml-5") {{t('set.strategy_firegate_desc')}}

                    //- Full Sell
                    button((click)="setStrategy('full')",
                        class="p-4 rounded-lg border text-left transition-all",
                        [class]="sellStrategy === 'full' ? 'bg-indigo-500/10 border-indigo-400/30' : 'bg-white/5 border-white/10 hover:border-white/20'")
                        div(class="flex items-center gap-2 mb-2")
                            div(class="w-3 h-3 rounded-full border-2 flex items-center justify-center",
                                [class]="sellStrategy === 'full' ? 'border-indigo-400' : 'border-slate-600'")
                                div(*ngIf="sellStrategy === 'full'",
                                    class="w-1.5 h-1.5 rounded-full bg-indigo-400")
                            span(class="text-[13px] font-medium",
                                [class]="sellStrategy === 'full' ? 'text-indigo-300' : 'text-slate-300'")
                                | {{t('set.strategy_full')}}
                        p(class="text-[11px] text-slate-500 ml-5") {{t('set.strategy_full_desc')}}

                    //- Partial Sell
                    button((click)="setStrategy('partial')",
                        class="p-4 rounded-lg border text-left transition-all",
                        [class]="sellStrategy === 'partial' ? 'bg-violet-500/10 border-violet-400/30' : 'bg-white/5 border-white/10 hover:border-white/20'")
                        div(class="flex items-center gap-2 mb-2")
                            div(class="w-3 h-3 rounded-full border-2 flex items-center justify-center",
                                [class]="sellStrategy === 'partial' ? 'border-violet-400' : 'border-slate-600'")
                                div(*ngIf="sellStrategy === 'partial'",
                                    class="w-1.5 h-1.5 rounded-full bg-violet-400")
                            span(class="text-[13px] font-medium",
                                [class]="sellStrategy === 'partial' ? 'text-violet-300' : 'text-slate-300'")
                                | {{t('set.strategy_partial')}}
                        p(class="text-[11px] text-slate-500 ml-5") {{t('set.strategy_partial_desc')}}

            //- Partial Sell Settings (shown only when partial selected)
            div(*ngIf="sellStrategy === 'partial'",
                class="p-4 rounded-lg bg-violet-500/5 border border-violet-400/10 space-y-4")
                h3(class="text-[13px] font-semibold text-violet-300 mb-1") {{t('set.strategy_partial')}} {{t('set.parameters')}}
                p(class="text-[11px] text-slate-500") {{t('set.partial_stage_desc')}}
                div(class="space-y-2")
                    div(*ngFor="let stage of partialSellStages",
                        class="flex items-center justify-between gap-3 px-3 py-2 rounded-lg bg-white/5 border border-white/5")
                        div(class="text-[12px] text-slate-300 font-medium") {{stage.roundLabel}}
                        div(class="text-[12px] text-slate-400") {{stage.triggerLabel}}
                        div(class="text-[12px] text-violet-300 font-semibold") {{stage.sellLabel}}
                div(class="px-3 py-3 rounded-lg bg-white/5 border border-white/5")
                    span(class="text-[13px] font-medium text-slate-200") {{t('set.partial_full_exit')}}
                    p(class="text-[11px] text-slate-500 mt-0.5") {{t('set.partial_rebuy_desc')}}

            //- Crash Buy Section
            div(class="pt-4 border-t border-white/5")
                div(class="flex items-center justify-between mb-4")
                    div
                        h3(class="text-[13px] font-semibold text-slate-300 flex items-center gap-2")
                            svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4 text-red-400")
                                path(stroke-linecap="round", stroke-linejoin="round", d="M2.25 6 9 12.75l4.286-4.286a11.948 11.948 0 0 1 4.306 6.43l.776 2.898m0 0 3.182-5.511m-3.182 5.51-5.511-3.181")
                            | {{t('set.crash_buy')}}
                        p(class="text-[11px] text-slate-500 mt-1") {{t('set.crash_buy_desc')}}
                    button((click)="crashBuyEnabled = !crashBuyEnabled; service.render();",
                        class="relative w-10 h-5 rounded-full transition-colors",
                        [class]="crashBuyEnabled ? 'bg-red-500' : 'bg-slate-600'")
                        div(class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform",
                            [class]="crashBuyEnabled ? 'translate-x-5' : 'translate-x-0.5'")

                //- Crash Buy Settings
                div(*ngIf="crashBuyEnabled",
                    class="p-4 rounded-lg bg-red-500/5 border border-red-400/10 space-y-4")

                    div(class="grid grid-cols-2 gap-4")
                        //- Daily Drop %
                        div
                            label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.crash_drop_pct')}}
                            input([(ngModel)]="crashBuyDropPct",
                                type="number",
                                step="0.5",
                                min="1",
                                max="30",
                                placeholder="5",
                                class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-red-400/50 transition-colors")
                            p(class="text-[10px] text-slate-600 mt-1") {{t('set.crash_drop_desc')}}

                        //- MA5 Drop %
                        div
                            label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.crash_ma_drop')}}
                            input([(ngModel)]="crashBuyMaDropPct",
                                type="number",
                                step="0.5",
                                min="1",
                                max="50",
                                placeholder="10",
                                class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[13px] text-slate-200 focus:outline-none focus:border-red-400/50 transition-colors")
                            p(class="text-[10px] text-slate-600 mt-1") {{t('set.crash_ma_desc')}}

                    div(class="grid grid-cols-2 gap-4")
                        //- Buy Ratio
                        div
                            label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.crash_ratio')}}
                            div(class="flex items-center gap-3")
                                input([(ngModel)]="crashBuyRatio",
                                    type="range", min="5", max="50", step="5",
                                    class="flex-1 accent-red-500")
                                span(class="text-sm font-medium text-white w-10 text-right") {{crashBuyRatio}}%

                        //- Max Per Cycle
                        div
                            label(class="block text-xs font-medium text-slate-400 mb-1") {{t('set.crash_max')}}
                            div(class="flex items-center gap-3")
                                input([(ngModel)]="crashBuyMaxPerCycle",
                                    type="range", min="1", max="10", step="1",
                                    class="flex-1 accent-red-500")
                                span(class="text-sm font-medium text-white w-10 text-right") {{crashBuyMaxPerCycle}}

            //- LOC Auto Schedule
            div(class="pt-4 border-t border-white/5")
                div(class="flex items-center justify-between")
                    div
                        h3(class="text-[13px] font-semibold text-slate-300 flex items-center gap-2")
                            svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4 text-cyan-300")
                                path(stroke-linecap="round", stroke-linejoin="round", d="M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z")
                            | 무한매수 LOC 자동 예약
                        p(class="text-[11px] text-slate-500 mt-1") 매일 10:00 KST부터 스케줄러 또는 대시보드 자동새로고침이 FireGate 표의 매수·매도 예약을 검증하고 누락분을 접수합니다. 접수 마감은 일반 23:20, 서머타임 22:20 KST입니다.
                    button((click)="locAutoScheduleEnabled = !locAutoScheduleEnabled; service.render();",
                        class="relative w-10 h-5 rounded-full transition-colors",
                        [class]="locAutoScheduleEnabled ? 'bg-cyan-500' : 'bg-slate-600'")
                        div(class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow transition-transform",
                            [class]="locAutoScheduleEnabled ? 'translate-x-5' : 'translate-x-0.5'")

            //- Save
            div(class="pt-4")
                button((click)="saveParams()",
                    class="px-4 py-2 rounded-lg bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-[13px] font-medium hover:bg-indigo-500/30 transition-colors")
                    | {{t('set.save_params')}}
