section(class="trading-controls", [class.daytrade-compact]="daytradeOnly", [class.locks-only]="locksOnly", *ngIf="!state || state.mode === 'LIVE'")
    div(class="control-heading", *ngIf="!locksOnly")
        div
            span(class="eyebrow") LIVE AUTOMATION
            h2 {{daytradeOnly ? '단타 자동매매' : '자동매매'}}
        span(class="account-badge") 실투자 계정
    p(*ngIf="!daytradeOnly && !locksOnly") SOXL은 무한매수 ON/OFF와 사이클 운영 상태로 제어합니다. 단타에서는 거래하지 않습니다.
    div(*ngIf="error", role="alert") {{error}}
    button(*ngIf="!state", (click)="refresh()") 상태 다시 확인
    div(*ngIf="state")
        p(*ngIf="!state.configured") 먼저 설정에서 실투자 API와 계좌번호를 연결하세요.
        p(*ngIf="!daytradeOnly && !locksOnly", role="status") {{locWorkerSummary}}
        div(class="strategy-grid", *ngIf="!locksOnly")
            button(*ngIf="!daytradeOnly", class="strategy-card", (click)="toggle('infinite_buy')", [disabled]="busy || !state.configured", [class.enabled]="state.infinite_buy", role="switch", aria-label="무한매수 자동매매", [attr.aria-checked]="state.infinite_buy")
                span(class="strategy-copy")
                    strong 무한매수
                    small 분할 매수 · 목표 수익 청산
                span(class="switch-state") {{state.infinite_buy ? 'ON' : 'OFF'}}
                span(class="switch-track")
            button(*ngIf="showDaytrade && market !== 'US'", class="strategy-card", (click)="toggle('daytrade_ks')", [disabled]="busy || !state.configured", [class.enabled]="state.daytrade_ks", role="switch", aria-label="국장 단타 자동매매", [attr.aria-checked]="state.daytrade_ks")
                span(class="strategy-copy")
                    strong 국장 단타
                    small 국내 주식 매수 · 매도 감시
                span(class="switch-state") {{state.daytrade_ks ? 'ON' : 'OFF'}}
                span(class="switch-track")
            button(*ngIf="showDaytrade && market !== 'KS'", class="strategy-card", (click)="toggle('daytrade_us')", [disabled]="busy || !state.configured", [class.enabled]="state.daytrade_us", role="switch", aria-label="미장 단타 자동매매", [attr.aria-checked]="state.daytrade_us")
                span(class="strategy-copy")
                    strong 미장 단타
                    small 미국 주식 매수 · 매도 감시
                span(class="switch-state") {{state.daytrade_us ? 'ON' : 'OFF'}}
                span(class="switch-track")
        p(*ngIf="!locksOnly && market !== 'US' && state.daytrade_ks") 국장 매수: {{workerSummary('entry_ks')}} / 매도: {{workerSummary('exit_ks')}}
        p(*ngIf="!locksOnly && market !== 'KS' && state.daytrade_us") 미장 매수: {{workerSummary('entry_us')}} / 매도: {{workerSummary('exit_us')}}
        p(*ngIf="!locksOnly") 잠금 또는 OFF는 이미 증권사에 접수된 주문을 취소하지 않습니다. 미체결 주문은 증권사에서 별도로 확인하세요.
        section(*ngIf="showLocks", class="holding-locks")
            div(class="holdings-heading")
                h3 보유 종목 · 자동매매 잠금
                button((click)="loadHoldings()", [disabled]="holdingsBusy") {{holdingsBusy ? '조회 중…' : '새로고침'}}
            p(*ngIf="holdingsMessage", role="alert") {{holdingsMessage}}
            p 직접 매매하는 종목은 🔒 잠금을 유지하세요. 잠그면 자동 매수·매도가 모두 차단됩니다. 대시보드에도 동일하게 적용됩니다.
            input(*ngIf="symbols.length", class="holding-search", [(ngModel)]="holdingSearch", placeholder="종목명 또는 코드 검색", aria-label="잠금 목록 종목 검색")
            div(*ngFor="let item of visibleSymbols", class="holding-lock-row")
                div(class="holding-identity")
                    strong {{symbolName(item)}}
                    small {{item}}
                button((click)="lock(item, !locked(item))", [disabled]="busy", [attr.aria-label]="symbolName(item) + ' ' + item + (locked(item) ? ' 잠금 해제' : ' 잠금')") {{locked(item) ? '🔒 잠김' : '🔓 허용'}}
            p(*ngIf="symbols.length && !visibleSymbols.length") 검색 결과가 없습니다.
            p(*ngIf="!symbols.length") 표시할 종목이 없습니다. 새 종목은 기본 잠금으로 보호됩니다.
div(*ngIf="pending", class="policy-overlay")
    section(class="policy-dialog", role="alertdialog", aria-modal="true", aria-labelledby="policy-warning-title")
        h2(id="policy-warning-title") 실투자 자동매매 위험 확인
        p(*ngIf="pending.symbol") 대상 종목: {{symbolName(pending.symbol)}} · {{pending.symbol}}
        p 실제 자금으로 주문되며 원금 손실이 발생할 수 있습니다. 수익을 보장하지 않습니다.
        p(class="investment-risk") 투자 판단과 그에 따른 손실은 투자자 본인에게 귀속됩니다. 감당 가능한 범위에서 신중하게 이용해 주세요.
        ul
            li 켠 자동매매만 실행합니다. 연결과 동기화만으로 주문이 시작되지는 않습니다.
            li SOXL은 무한매수 ON과 본인 계정의 운영 중인 사이클로 제어하며, 별도 종목 잠금을 사용하지 않습니다. 단타에서는 항상 차단합니다.
            li 그 외 종목은 기본 잠금입니다. 잠금 해제한 종목만 자동매매합니다.
            li SOXL을 개인적으로 관리하려면 무한매수를 OFF하거나 사이클을 중지하세요. 다른 개인 매매 종목은 반드시 잠그세요.
            li 잠금은 계좌의 종목 전체에 적용됩니다. 같은 종목의 개인 매매 수량과 프로그램 수량은 증권사에서 합산되므로, 개인 매매 종목은 잠금을 유지하세요.
            li 잠금 해제 시 이미 켜진 자동매매가 즉시 주문할 수 있으니 대상을 확인하세요.
            li OFF 또는 잠금은 기존 접수 주문을 취소하지 않습니다. 증권사 미체결 주문을 별도로 확인하세요.
            li 서버나 API 장애 시 자동매매와 손절이 중단될 수 있습니다.
        label
            input(type="checkbox", [(ngModel)]="acknowledged")
            span 위 내용을 확인했고, 선택한 전략 또는 종목의 자동매매를 허용합니다.
        div(class="strategy-grid")
            button((click)="cancel()", [disabled]="busy") 취소
            button((click)="confirm()", [disabled]="!acknowledged || busy") 확인하고 적용
