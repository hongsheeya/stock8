//- ============================================================
//- 거래이력: 성과 · 체결 · 무한매수 사이클 · 주문 로그
//- ============================================================

div(class="dx-head")
    div(class="dx-title")
        h1 거래이력
        span(*ngIf="(tab === 'performance' || tab === 'fills') && tradesLoaded", class="dx-chip") {{periodLabel}}{{market ? ' · ' + marketLabel(market) : ''}}{{strategy ? ' · ' + strategyLabel : ''}}
    div(class="dx-tools")
        button((click)="refresh()", [disabled]="loading", class="dx-tool") {{loading ? '불러오는 중' : '새로고침'}}
        span(*ngIf="updatedAt", class="dx-updated") {{updatedAt}}

nav(class="hx-tabs")
    button(*ngIf="showDaytrade", [class.is-active]="tab === 'performance'", (click)="switchTab('performance')") 성과
    button(*ngIf="showDaytrade", [class.is-active]="tab === 'fills'", (click)="switchTab('fills')") 체결 내역
    button([class.is-active]="tab === 'cycles'", (click)="switchTab('cycles')") 무한매수 사이클
    button([class.is-active]="tab === 'logs'", (click)="switchTab('logs')") 주문 로그

div(*ngIf="loadError", class="dx-alert is-warn hx-gap")
    strong 불러오기 실패
    span {{loadError}}

//- ── Shared filters for 성과 / 체결 ─────────────────────────────
div(*ngIf="tab === 'performance' || tab === 'fills'", class="hx-filters")
    div(class="hx-seg")
        button(*ngFor="let p of periods", [class.is-on]="period === p.id", (click)="setPeriod(p.id)") {{p.label}}
    div(class="hx-seg")
        button(*ngFor="let m of markets", [class.is-on]="market === m.id", (click)="setMarket(m.id)") {{m.label}}
    select(class="hx-select", [ngModel]="strategy", (ngModelChange)="setStrategy($event)")
        option(value="") 전체 전략
        option(*ngFor="let s of data.strategy_options", [value]="s.id") {{s.label}}

//- ============================================================
//- 성과
//- ============================================================
ng-container(*ngIf="tab === 'performance'")
    div(*ngIf="loading && !tradesLoaded", class="dx-card dx-empty") 불러오는 중…
    ng-container(*ngIf="tradesLoaded")
        div(*ngIf="summaryMarkets.length === 0", class="dx-card dx-empty") 이 기간에 청산된 거래가 없습니다.

        div(*ngIf="summaryMarkets.length > 0", class="dx-kpis")
            div(class="dx-kpi")
                div(class="dx-kpi-label") 실현손익
                div(*ngFor="let m of summaryMarkets", class="hx-kpi-line")
                    small {{marketLabel(m)}}
                    strong([class]="tone(data.summary[m].net)") {{money(data.summary[m].net, m, true)}}
                div(class="dx-kpi-note") 수수료·세금 차감 후
            div(class="dx-kpi")
                div(class="dx-kpi-label") 승률
                div(*ngFor="let m of summaryMarkets", class="hx-kpi-line")
                    small {{marketLabel(m)}}
                    strong {{data.summary[m].win_rate === null ? '-' : data.summary[m].win_rate + '%'}}
                    em {{data.summary[m].wins}}승 {{data.summary[m].losses}}패
            div(class="dx-kpi")
                div(class="dx-kpi-label") 평균 익절 / 손절
                div(*ngFor="let m of summaryMarkets", class="hx-kpi-line")
                    small {{marketLabel(m)}}
                    strong
                        span(class="up") {{money(data.summary[m].avg_win, m, true)}}
                        span(class="hx-slash") /
                        span(class="down") {{money(data.summary[m].avg_loss, m, true)}}
                div(class="dx-kpi-note") 손익비 = 총이익 ÷ 총손실
            div(class="dx-kpi")
                div(class="dx-kpi-label") 손익비 · 평균 보유
                div(*ngFor="let m of summaryMarkets", class="hx-kpi-line")
                    small {{marketLabel(m)}}
                    strong {{data.summary[m].profit_factor === null ? '-' : data.summary[m].profit_factor}}
                    em {{hold(data.summary[m].avg_hold_min)}} · {{data.summary[m].closed}}건

        //- Best / worst
        div(*ngIf="summaryMarkets.length > 0", class="hx-extremes")
            ng-container(*ngFor="let m of summaryMarkets")
                div(*ngIf="data.summary[m].best", class="hx-extreme")
                    span 최고 · {{marketLabel(m)}}
                    strong {{data.summary[m].best.name}}
                    b(class="up") {{money(data.summary[m].best.net, m, true)}} ({{pct(data.summary[m].best.return_pct)}})
                div(*ngIf="data.summary[m].worst", class="hx-extreme")
                    span 최저 · {{marketLabel(m)}}
                    strong {{data.summary[m].worst.name}}
                    b(class="down") {{money(data.summary[m].worst.net, m, true)}} ({{pct(data.summary[m].worst.return_pct)}})

        //- Strategy performance
        section(*ngIf="data.strategies?.length > 0", class="dx-card")
            div(class="dx-card-head")
                h2 전략별 성과
                span(class="dx-muted") 행을 누르면 해당 전략만 봅니다
            div(class="dx-table-wrap")
                table(class="dx-table")
                    thead
                        tr
                            th 전략
                            th 시장
                            th(class="num") 거래
                            th(class="num") 승률
                            th(class="num") 실현손익
                            th(class="num") 평균 수익률
                            th(class="num") 손익비
                            th(class="num") 평균 보유
                            th(class="num") 최근 청산
                    tbody
                        tr(*ngFor="let s of data.strategies", class="hx-click", [class.is-selected]="strategy === s.strategy_id", (click)="setStrategy(s.strategy_id)")
                            td
                                span(class="dx-strategy") {{s.label}}
                            td
                                span(class="hx-market", [class.is-us]="s.market === 'US'") {{marketLabel(s.market)}}
                            td(class="num") {{s.closed}}
                            td(class="num") {{s.win_rate === null ? '-' : s.win_rate + '%'}}
                                small(class="dx-muted") {{s.wins}}승 {{s.closed - s.wins}}패
                            td(class="num dx-strong", [class]="tone(s.net)") {{money(s.net, s.market, true)}}
                            td(class="num", [class]="tone(s.avg_return_pct)") {{pct(s.avg_return_pct)}}
                            td(class="num") {{s.profit_factor === null ? '-' : s.profit_factor}}
                            td(class="num") {{hold(s.avg_hold_min)}}
                            td(class="num dx-muted") {{when(s.last_exit_at)}}

        //- Daily realized P&L
        section(*ngIf="dailyMarkets.length > 0 && period !== '1D'", class="dx-card")
            div(class="dx-card-head")
                h2 일별 실현손익
            div(*ngFor="let m of dailyMarkets", class="hx-daily")
                div(class="hx-daily-label") {{marketLabel(m)}}
                div(class="hx-bars")
                    div(*ngFor="let b of dailyBars(m)", class="hx-bar", [title]="b.date + ' ' + money(b.value, m, true)")
                        i([class]="b.up ? 'up-bg' : 'down-bg'", [style.height.%]="b.height")
                        small {{b.date.slice(5)}}

        //- Closed trades
        section(class="dx-card")
            div(class="dx-card-head")
                h2 청산 거래
                    span(class="dx-count") {{filteredTrips.length}}
                input(class="hx-search", type="search", placeholder="종목·전략·사유 검색", [(ngModel)]="tripSearch")
            div(*ngIf="filteredTrips.length === 0", class="dx-empty") 청산된 거래가 없습니다.
            div(*ngIf="filteredTrips.length > 0", class="dx-table-wrap")
                table(class="dx-table")
                    thead
                        tr
                            th 청산
                            th 종목
                            th 전략
                            th(class="num") 진입 → 청산
                            th(class="num") 수량
                            th(class="num") 보유
                            th(class="num") 손익
                            th 사유
                    tbody
                        tr(*ngFor="let r of visibleTrips")
                            td(class="dx-muted hx-nowrap") {{when(r.exit_at)}}
                            td
                                div(class="dx-sym")
                                    strong {{r.name}}
                                    small {{r.symbol}}
                                span(class="hx-market", [class.is-us]="r.market === 'US'") {{marketLabel(r.market)}}
                            td
                                span(class="dx-strategy") {{r.strategy_label}}
                            td(class="num")
                                | {{price(r.entry_price, r.market)}} → {{price(r.exit_price, r.market)}}
                            td(class="num") {{r.qty | number}}
                                small(*ngIf="r.partial", class="dx-muted") 일부 청산
                                small(*ngIf="r.unmatched_qty > 0", class="hx-warn") {{r.unmatched_qty | number}}주 매수기록 없음
                            td(class="num") {{hold(r.hold_min)}}
                            td(class="num")
                                ng-container(*ngIf="r.cost_known")
                                    strong([class]="tone(r.net)") {{money(r.net, r.market, true)}}
                                    small([class]="tone(r.return_pct)") {{pct(r.return_pct)}}
                                span(*ngIf="!r.cost_known", class="dx-muted") 원가 미확인
                            td
                                span(class="hx-exit", [class]="'is-' + r.exit_kind", [title]="r.reason") {{r.exit_label}}
            button(*ngIf="filteredTrips.length > visibleTrips.length", class="hx-more", (click)="moreTrips()") 더보기 ({{filteredTrips.length - visibleTrips.length}})

//- ============================================================
//- 체결 내역
//- ============================================================
ng-container(*ngIf="tab === 'fills'")
    div(*ngIf="loading && !tradesLoaded", class="dx-card dx-empty") 불러오는 중…
    section(*ngIf="tradesLoaded", class="dx-card")
        div(class="dx-card-head")
            h2 체결 내역
                span(class="dx-count") {{filteredFills.length}}
            input(class="hx-search", type="search", placeholder="종목·전략·사유 검색", [(ngModel)]="fillSearch")
        div(*ngIf="filteredFills.length === 0", class="dx-empty") 체결 내역이 없습니다.
        div(*ngIf="filteredFills.length > 0", class="dx-table-wrap")
            table(class="dx-table")
                thead
                    tr
                        th 시각
                        th 종목
                        th 전략
                        th 구분
                        th(class="num") 수량
                        th(class="num") 체결가
                        th(class="num") 금액
                        th(class="num") 실현손익
                tbody
                    tr(*ngFor="let r of visibleFills", [title]="r.reason")
                        td(class="dx-muted hx-nowrap") {{when(r.timestamp)}}
                        td
                            div(class="dx-sym")
                                strong {{r.name}}
                                small {{r.symbol}}
                            span(class="hx-market", [class.is-us]="r.market === 'US'") {{marketLabel(r.market)}}
                        td
                            span(class="dx-strategy") {{r.strategy_label}}
                        td
                            span(class="hx-side", [class.is-buy]="r.side === 'BUY'", [class.is-sell]="r.side === 'SELL'") {{r.label}}
                        td(class="num") {{r.qty | number}}
                        td(class="num") {{price(r.price, r.market)}}
                        td(class="num") {{money(r.amount, r.market)}}
                        td(class="num")
                            ng-container(*ngIf="r.side === 'SELL' && r.net !== null")
                                strong([class]="tone(r.net)") {{money(r.net, r.market, true)}}
                                small([class]="tone(r.return_pct)") {{pct(r.return_pct)}}
                            span(*ngIf="r.side !== 'SELL' || r.net === null", class="dx-muted") -
        button(*ngIf="filteredFills.length > visibleFills.length", class="hx-more", (click)="moreFills()") 더보기 ({{filteredFills.length - visibleFills.length}})

//- ============================================================
//- 무한매수 사이클
//- ============================================================
ng-container(*ngIf="tab === 'cycles' && !selectedCycle")
    div(class="hx-filters")
        div(class="hx-seg")
            button([class.is-on]="cycleFilter === ''", (click)="filterCycles('')") 전체
            button([class.is-on]="cycleFilter === 'ACTIVE'", (click)="filterCycles('ACTIVE')") 진행 중
            button([class.is-on]="cycleFilter === 'COMPLETED'", (click)="filterCycles('COMPLETED')") 완료
        select(class="hx-select", [ngModel]="cycleSymbolFilter", (ngModelChange)="filterCycleSymbol($event)")
            option(value="") 전체 종목
            option(*ngFor="let s of symbols", [value]="s") {{s}}
    section(class="dx-card")
        div(*ngIf="!loading && cycles.length === 0", class="dx-empty") 사이클이 없습니다.
        div(*ngIf="cycles.length > 0", class="dx-table-wrap")
            table(class="dx-table")
                thead
                    tr
                        th 종목
                        th 상태
                        th 진행
                        th(class="num") 투입 / 한도
                        th(class="num") 평단 · 수량
                        th(class="num") 수익률
                        th(class="num") 실현손익
                        th(class="num") 기간
                        th
                tbody
                    tr(*ngFor="let c of cycles", class="hx-click", (click)="viewCycleDetail(c)")
                        td
                            div(class="dx-sym")
                                strong {{c.symbol}}
                                small {{'#' + c.cycle_number}}
                        td
                            span(class="hx-status", [class]="'is-' + (c.status || '').toLowerCase()") {{cycleStatusLabel(c.status)}}
                        td
                            div(class="dx-progress")
                                div(class="dx-progress-bar")
                                    i([style.width.%]="cycleProgress(c)")
                                span {{c.current_round || 0}}/{{c.division_count || 40}}
                        td(class="num") {{money(c.total_spent, 'US')}}
                            small(class="dx-muted") / {{money(c.total_investment, 'US')}}
                        td(class="num") {{price(c.avg_price, 'US')}}
                            small(class="dx-muted") {{c.total_qty || 0}}주
                        td(class="num dx-strong", [class]="tone(c.profit_rate)") {{pct(c.profit_rate)}}
                        td(class="num", [class]="tone(c.realized)") {{c.realized ? money(c.realized, 'US', true) : '-'}}
                        td(class="num dx-muted") {{c.days === null ? '-' : c.days + '일'}}
                            small {{(c.started_at || '').slice(0, 10)}}
                        td(class="num")
                            button(*ngIf="c.status === 'COMPLETED' || c.status === 'PAUSED'", class="hx-icon-btn", title="삭제", (click)="$event.stopPropagation(); deleteCycle(c)") 삭제
        div(*ngIf="cycleTotalPages > 1", class="hx-pages")
            button(*ngFor="let p of pageArray(cycleTotalPages)", [class.is-on]="p === cyclePage", (click)="goCyclePage(p)") {{p}}

ng-container(*ngIf="tab === 'cycles' && selectedCycle")
    section(class="dx-card")
        div(class="dx-card-head")
            div(class="dx-sym")
                button(class="dx-tool", (click)="closeCycleDetail()") ← 목록
                strong {{selectedCycle.symbol}}
                small {{'#' + selectedCycle.cycle_number}}
                span(class="hx-status", [class]="'is-' + (selectedCycle.status || '').toLowerCase()") {{cycleStatusLabel(selectedCycle.status)}}
        div(class="dx-detail-grid")
            div(class="dx-detail")
                | 진행
                strong {{selectedCycle.current_round || 0}} / {{selectedCycle.division_count || 40}}회
            div(class="dx-detail")
                | 투입 / 한도
                strong {{money(selectedCycle.total_spent, 'US')}} / {{money(selectedCycle.total_investment, 'US')}}
            div(class="dx-detail")
                | 평단 · 수량
                strong {{price(selectedCycle.avg_price, 'US')}} · {{selectedCycle.total_qty || 0}}주
            div(class="dx-detail")
                | 수익률 · 목표
                strong([class]="tone(selectedCycle.profit_rate)") {{pct(selectedCycle.profit_rate)}}
                small 목표 {{selectedCycle.target_profit || '-'}}%
            div(class="dx-detail")
                | 실현손익
                strong([class]="tone(selectedCycle.realized)") {{selectedCycle.realized ? money(selectedCycle.realized, 'US', true) : '-'}}
            div(class="dx-detail")
                | 기간
                strong {{selectedCycle.days === null || selectedCycle.days === undefined ? '-' : selectedCycle.days + '일'}}
                small {{(selectedCycle.started_at || '').slice(0, 16)}} ~ {{(selectedCycle.completed_at || '진행 중').slice(0, 16)}}
    section(class="dx-card")
        div(class="dx-card-head")
            h2 회차별 체결
                span(class="dx-count") {{cycleTrades.length}}
        div(*ngIf="cycleTrades.length === 0", class="dx-empty") 체결 기록이 없습니다.
        div(*ngIf="cycleTrades.length > 0", class="dx-table-wrap")
            table(class="dx-table")
                thead
                    tr
                        th 회차
                        th 날짜
                        th 구분
                        th(class="num") 체결가
                        th(class="num") 수량
                        th(class="num") 금액
                        th(class="num") 평단 (후)
                        th(class="num") 보유 (후)
                        th 메모
                tbody
                    tr(*ngFor="let tr of cycleTrades")
                        td {{tr.round}}
                        td(class="dx-muted hx-nowrap") {{tr.trade_date || (tr.created || '').slice(0, 10)}}
                        td
                            span(class="hx-side", [class.is-buy]="tr.action === 'BUY'", [class.is-sell]="tr.action === 'SELL'") {{tr.action === 'BUY' ? '매수' : (tr.action === 'SELL' ? '매도' : tr.action)}}
                        td(class="num") {{price(tr.filled_price || tr.order_price, 'US')}}
                        td(class="num") {{tr.filled_qty || tr.order_qty || 0}}
                        td(class="num") {{money(tr.filled_amount, 'US')}}
                        td(class="num") {{price(tr.avg_buy_price, 'US')}}
                        td(class="num") {{tr.total_qty_after || 0}}
                        td(class="dx-muted dx-ellipsis", [title]="tr.memo || ''") {{tr.memo || '-'}}

//- ============================================================
//- 주문 로그
//- ============================================================
ng-container(*ngIf="tab === 'logs'")
    div(class="hx-filters")
        div(class="hx-seg")
            button(*ngFor="let k of logKinds", [class.is-on]="logKind === k.id", (click)="setLogKind(k.id)") {{k.label}}
        select(class="hx-select", [ngModel]="logSymbolFilter", (ngModelChange)="filterLogSymbol($event)")
            option(value="") 전체 종목
            option(*ngFor="let s of symbols", [value]="s") {{s}}
        input(class="hx-search", type="search", placeholder="메시지 검색 후 Enter", [(ngModel)]="logSearchText", (keyup.enter)="searchLogs()")
    section(class="dx-card")
        div(class="dx-card-head")
            h2 주문 로그
                span(*ngIf="!loading", class="dx-count") {{logTotal | number}}
            span(class="dx-muted") 자동 점검·예약 갱신 같은 반복 기록은 '시스템 포함'에서만 보입니다
        div(*ngIf="loading && logs.length === 0", class="dx-empty") 불러오는 중…
        div(*ngIf="!loading && logs.length === 0", class="dx-empty") 로그가 없습니다.
        div(*ngIf="logs.length > 0", class="dx-table-wrap")
            table(class="dx-table hx-logs")
                thead
                    tr
                        th 시각
                        th 구분
                        th 종목
                        th 이벤트
                        th(class="num") 수량 · 가격
                        th 내용
                tbody
                    tr(*ngFor="let r of logs", class="hx-click", (click)="toggleLog(r)")
                        td(class="dx-muted hx-nowrap") {{when(r.created)}}
                        td(class="dx-muted hx-nowrap") {{r.lane}}
                        td
                            strong {{r.symbol || '-'}}
                        td
                            span(class="hx-event", [class]="'is-' + r.tone") {{r.label}}
                        td(class="num")
                            ng-container(*ngIf="(r.filled_qty || r.order_qty) > 0")
                                | {{r.filled_qty || r.order_qty}}주
                                small(class="dx-muted") {{price(r.filled_price || r.order_price, r.market)}}
                            span(*ngIf="!((r.filled_qty || r.order_qty) > 0)", class="dx-muted") -
                        td(class="hx-message", [class.is-open]="expandedLog === r.id") {{r.message || '-'}}
        button(*ngIf="logHasMore", class="hx-more", [disabled]="loadingMore", (click)="moreLogs()") {{loadingMore ? '불러오는 중' : '더보기'}} ({{logTotal - logs.length | number}})
